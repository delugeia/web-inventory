APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://web-inventory.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=web_inventory
DB_USERNAME=web_inventory
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

# Endpoint resolver HTTP settings.
RESOLVER_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/149.0.0.0 Safari/537.36 Edg/149.0.0.0"

# Optional rendered-page capture. Requires Node.js and Playwright browser binaries.
RENDERED_CAPTURE_ENABLED=false
RENDERED_CAPTURE_NODE_BINARY=node
RENDERED_CAPTURE_TIMEOUT_SECONDS=12
RENDERED_CAPTURE_SETTLE_MILLISECONDS=1500
RENDERED_CAPTURE_MAX_TEXT_CHARS=50000
RENDERED_CAPTURE_MAX_HTML_CHARS=100000
RENDERED_CAPTURE_VIEWPORT_WIDTH=1366
RENDERED_CAPTURE_VIEWPORT_HEIGHT=900

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# OpenAI webpage analysis. See OPENAI-API-SETUP.md before populating these values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_INPUT_CHARS=50000
OPENAI_ANALYSIS_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
